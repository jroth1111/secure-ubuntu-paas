ARG NODE_IMAGE=node:24-bookworm
ARG BASE_IMAGE=dokploy/dokploy:latest
ARG GO_IMAGE=golang:bookworm
FROM ${GO_IMAGE} AS build_helpers
ARG PACK_VERSION
ARG RAILPACK_VERSION
ENV CGO_ENABLED=0 GOMAXPROCS=2 GOTOOLCHAIN=local
RUN apt-get update && apt-get install -y python3 && rm -rf /var/lib/apt/lists/*
COPY patch-go-deps.py go-security-floors.json /usr/local/lib/
RUN git clone --depth 1 --branch "v${PACK_VERSION}" https://github.com/buildpacks/pack.git /src/pack \
 && cd /src/pack \
 && mkdir -p /out \
 && python3 /usr/local/lib/patch-go-deps.py /usr/local/lib/go-security-floors.json /out/pack-security.json \
 && go build -trimpath -ldflags="-s -w -X github.com/buildpacks/pack/pkg/client.Version=${PACK_VERSION}" -o /out/pack . \
 && go test ./pkg/archive ./pkg/project ./pkg/buildpack \
 && /out/pack --version && /out/pack --help >/dev/null
RUN git clone --depth 1 --branch "v${RAILPACK_VERSION}" https://github.com/railwayapp/railpack.git /src/railpack \
 && cd /src/railpack \
 && python3 /usr/local/lib/patch-go-deps.py /usr/local/lib/go-security-floors.json /out/railpack-security.json \
 && go build -trimpath -ldflags="-s -w -X main.version=${RAILPACK_VERSION}" -o /out/railpack ./cmd/cli \
 && runuser -u nobody -- env HOME=/tmp GOCACHE=/tmp/railpack-security-test-cache GOPROXY=off go test ./core/app ./core/plan \
 && /out/railpack --version && /out/railpack --help >/dev/null \
 && /out/railpack schema >/dev/null
FROM ${NODE_IMAGE} AS builder
# Keep helper compilation and the memory-heavy panel build sequential on a single VPS.
COPY --from=build_helpers /out/pack-security.json /tmp/pack-security-build-ready.json
ARG PNPM_VERSION=10.22.0
ARG NPM_VERSION
ENV PNPM_HOME=/pnpm
ENV PATH=/pnpm:$PATH
ENV NODE_OPTIONS=--max-old-space-size=3072
RUN npm install -g "npm@${NPM_VERSION}" && corepack enable && corepack prepare "pnpm@${PNPM_VERSION}" --activate
RUN apt-get update && apt-get install -y python3 python3-yaml make g++ git pkg-config libsecret-1-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /usr/src/app
COPY source .
COPY security-overrides.json /tmp/security-overrides.json
COPY apply-overrides.cjs /tmp/apply-overrides.cjs
RUN PNPM_VERSION="${PNPM_VERSION}" node /tmp/apply-overrides.cjs && pnpm install --lockfile-only --ignore-scripts && pnpm install --frozen-lockfile
ENV NODE_ENV=production
RUN pnpm --filter=@dokploy/server build && pnpm --filter=./apps/dokploy run build
RUN pnpm --filter=./apps/dokploy --prod deploy --legacy /prod/dokploy
RUN cp -R apps/dokploy/.next /prod/dokploy/.next && cp -R apps/dokploy/dist /prod/dokploy/dist
FROM ${GO_IMAGE} AS native_compilers
ENV CGO_ENABLED=0 GOMAXPROCS=2 GOTOOLCHAIN=local
RUN apt-get update && apt-get install -y python3 && rm -rf /var/lib/apt/lists/*
COPY --from=builder /prod/dokploy/node_modules /modules
COPY rebuild-esbuild.py /usr/local/lib/rebuild-esbuild.py
COPY patch-go-deps.py go-security-floors.json /usr/local/lib/
RUN python3 /usr/local/lib/rebuild-esbuild.py
FROM ${BASE_IMAGE} AS hardened
ARG BASE_IMAGE
ARG SOURCE_COMMIT
LABEL org.opencontainers.image.base.name=${BASE_IMAGE}
LABEL local.paas.security-layer="20261006-compatible-v3"
LABEL local.paas.source.commit=${SOURCE_COMMIT}
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get upgrade -y && apt-get remove -y docker-ce docker-ce-rootless-extras containerd.io && apt-get clean && rm -rf /var/lib/apt/lists/*
RUN rm -rf /app/node_modules /app/.next /app/dist /usr/local/lib/node_modules /root/.cache/node/corepack
COPY --from=builder /usr/local/bin/node /usr/local/bin/node
COPY --from=builder /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=builder /root/.cache/node/corepack /root/.cache/node/corepack
COPY --from=builder /usr/src/app/pnpm-lock.yaml /usr/local/lib/paas-source-lock.yaml
COPY --from=build_helpers /out/pack /usr/local/bin/pack
COPY --from=build_helpers /out/railpack /usr/local/bin/railpack
COPY --from=build_helpers /out/pack-security.json /out/railpack-security.json /usr/local/lib/
COPY --from=builder /prod/dokploy/.next /app/.next
COPY --from=builder /prod/dokploy/dist /app/dist
COPY --from=builder /prod/dokploy/package.json /app/package.json
COPY --from=builder /prod/dokploy/drizzle /app/drizzle
COPY --from=builder /prod/dokploy/public /app/public
COPY --from=builder /prod/dokploy/next.config.mjs /app/next.config.mjs
COPY --from=builder /prod/dokploy/node_modules /app/node_modules
COPY --from=native_compilers /patched/ /app/node_modules/
COPY --from=native_compilers /out/native-compilers.json /usr/local/lib/native-compilers.json
COPY verify-floors.cjs /usr/local/lib/verify-floors.cjs
COPY security-overrides.json /usr/local/lib/security-overrides.json
RUN node /usr/local/lib/verify-floors.cjs /app/node_modules /usr/local/lib/security-overrides.json
COPY patch-node-tooling.cjs /usr/local/lib/patch-node-tooling.cjs
RUN node /usr/local/lib/patch-node-tooling.cjs && node /usr/local/lib/verify-floors.cjs /usr/local/lib/node_modules /usr/local/lib/security-overrides.json
RUN node --version && docker --version && node -e "const v=require('/app/node_modules/next/package.json').version.split('.').map(Number);if(v[0]<16||(v[0]===16&&(v[1]<3||(v[1]===3&&v[2]<6))))throw Error('Next security patch missing')"

FROM ubuntu:24.04@sha256:561618e2c15bf2397621dd04f96926663a3b5616c189cf7e38db7e82f5c538ea

ENV DEBIAN_FRONTEND=noninteractive
ENV container=docker
ARG BATS_CORE_COMMIT=3bca150ec86275d6d9d5a4fd7d48ab8b6c6f3d87
ARG BATS_ASSERT_COMMIT=f1e9280eaae8f86cbe278a687e6ba755bc802c1a
ARG BATS_SUPPORT_COMMIT=24a72e14349690bcbf7c151b9d2d1cdd32d36eb1

# Install systemd + script dependencies + BATS tooling
RUN apt-get update && apt-get install -y --no-install-recommends \
      systemd systemd-sysv dbus \
      ufw openssh-server iptables fail2ban \
      unattended-upgrades apt-listchanges \
      auditd audispd-plugins \
      iproute2 sudo git ca-certificates jq \
    && rm -rf /var/lib/apt/lists/* \
    && (cd /lib/systemd/system/sysinit.target.wants/ && \
        ls | grep -v systemd-tmpfiles-setup | xargs rm -f) \
    && rm -f /lib/systemd/system/multi-user.target.wants/* \
    && rm -f /etc/systemd/system/*.wants/* \
    && rm -f /lib/systemd/system/local-fs.target.wants/* \
    && rm -f /lib/systemd/system/sockets.target.wants/*udev* \
    && rm -f /lib/systemd/system/sockets.target.wants/*initctl* \
    && rm -f /lib/systemd/system/basic.target.wants/* \
    && rm -f /lib/systemd/system/anaconda.target.wants/*

# BATS + helpers (immutable commits; verify the checked-out revision before use)
RUN git clone --no-checkout --filter=blob:none --depth 1 https://github.com/bats-core/bats-core.git /opt/bats-core && \
    git -C /opt/bats-core fetch --depth 1 origin ${BATS_CORE_COMMIT} && \
    git -C /opt/bats-core checkout --detach ${BATS_CORE_COMMIT} && \
    test "$(git -C /opt/bats-core rev-parse HEAD)" = "${BATS_CORE_COMMIT}" && \
    /opt/bats-core/install.sh /usr/local && \
    git clone --no-checkout --filter=blob:none --depth 1 https://github.com/bats-core/bats-assert.git /opt/bats-assert && \
    git -C /opt/bats-assert fetch --depth 1 origin ${BATS_ASSERT_COMMIT} && \
    git -C /opt/bats-assert checkout --detach ${BATS_ASSERT_COMMIT} && \
    test "$(git -C /opt/bats-assert rev-parse HEAD)" = "${BATS_ASSERT_COMMIT}" && \
    git clone --no-checkout --filter=blob:none --depth 1 https://github.com/bats-core/bats-support.git /opt/bats-support && \
    git -C /opt/bats-support fetch --depth 1 origin ${BATS_SUPPORT_COMMIT} && \
    git -C /opt/bats-support checkout --detach ${BATS_SUPPORT_COMMIT} && \
    test "$(git -C /opt/bats-support rev-parse HEAD)" = "${BATS_SUPPORT_COMMIT}"

# Stubs for auditd (kernel audit subsystem unavailable in containers)
RUN printf '#!/bin/bash\nexit 0\n' > /usr/local/bin/augenrules && chmod +x /usr/local/bin/augenrules
RUN cat > /usr/local/bin/auditctl << 'SCRIPT'
#!/bin/bash
if [[ "$1" == "--load" ]]; then
  exit 0
fi
if [[ "$1" == "-s" ]]; then
  echo "enabled 1"
  echo "failure 1"
  echo "pid 123"
  echo "rate_limit 0"
  echo "backlog_limit 8192"
  echo "lost 0"
  echo "backlog 0"
  exit 0
fi
echo "-w /etc/passwd -p wa -k identity"
echo "-w /etc/shadow -p wa -k identity"
echo "-w /etc/group -p wa -k identity"
echo "-w /etc/gshadow -p wa -k identity"
echo "-w /etc/ssh/sshd_config -p wa -k sshd-config"
echo "-w /etc/ssh/sshd_config.d/ -p wa -k sshd-config"
echo "-w /etc/localtime -p wa -k time-change"
echo "-w /etc/sudoers -p wa -k sudoers-change"
echo "-w /etc/sudoers.d/ -p wa -k sudoers-change"
echo "-a always,exit -F path=/etc/modules -F perm=wa -k kernel-module"
echo "-a always,exit -F dir=/etc/modprobe.d -F perm=wa -k kernel-module"
echo "-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -F auid>=1000 -F auid!=unset -k kernel-module"
echo "-a always,exit -F arch=b32 -S init_module,finit_module,delete_module -F auid>=1000 -F auid!=unset -k kernel-module"
echo "-w /usr/bin/docker -p x -k container-runtime"
echo "-w /usr/bin/dockerd -p x -k container-runtime"
echo "-w /usr/bin/containerd -p x -k container-runtime"
echo "-a always,exit -F arch=b64 -S execve -F auid>=1000 -F auid!=unset -k user_commands"
echo "-a always,exit -F arch=b32 -S execve -F auid>=1000 -F auid!=unset -k user_commands"
exit 0
SCRIPT
RUN chmod +x /usr/local/bin/auditctl

# Docker CLI stub: enables DOCKER-USER rule application path in tests.
RUN printf '#!/bin/bash\nexit 0\n' > /usr/local/bin/docker && chmod +x /usr/local/bin/docker

# Symlink so audit rules detect Docker binaries at /usr/bin/ paths
RUN ln -sf /usr/local/bin/docker /usr/bin/docker && \
    ln -sf /usr/local/bin/docker /usr/bin/dockerd && \
    ln -sf /usr/local/bin/docker /usr/bin/containerd

# Sysctl wrapper: filter kernel.* errors (not namespace-aware in containers)
RUN mv /usr/sbin/sysctl /usr/sbin/sysctl.real
RUN cat > /usr/sbin/sysctl << 'SCRIPT'
#!/bin/bash
if [[ "$1" == "--system" ]]; then
  /usr/sbin/sysctl.real --system 2>&1 | grep -v "^sysctl: setting key .kernel\." || true
  exit 0
fi
exec /usr/sbin/sysctl.real "$@"
SCRIPT
RUN chmod +x /usr/sbin/sysctl

# SSH host keys + runtime dir
RUN ssh-keygen -A && mkdir -p /run/sshd

VOLUME ["/sys/fs/cgroup"]
CMD ["/lib/systemd/systemd"]
